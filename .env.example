# Environment Configuration for iAm Monorepo
# Copy this file to .env and fill in the values

# ============================================================================
# General
# ============================================================================
NODE_ENV=development
LOG_LEVEL=debug

# ============================================================================
# Database (PostgreSQL)
# ============================================================================
# For Docker Compose:
DATABASE_URL="postgresql://iam:iam_dev_password@localhost:5432/iam_dev?schema=public"

# For production (example):
# DATABASE_URL="postgresql://user:password@host:5432/database?schema=public&sslmode=require"

# ============================================================================
# Redis (Cache & Queue)
# ============================================================================
# For Docker Compose:
REDIS_URL="redis://localhost:6379"

# For production (example):
# REDIS_URL="rediss://user:password@host:6379"

# ============================================================================
# Neo4j (Graph Database)
# ============================================================================
# For Docker Compose:
NEO4J_URL="bolt://localhost:7687"
NEO4J_USERNAME="neo4j"
NEO4J_PASSWORD="iam_dev_password"

# For production (example):
# NEO4J_URL="neo4j+s://xxxxx.databases.neo4j.io"
# NEO4J_USERNAME="neo4j"
# NEO4J_PASSWORD="your-secure-password"

# ============================================================================
# JWT Authentication
# ============================================================================
# Generate a secure random string for production (min 32 characters)
# Example: openssl rand -base64 32
JWT_SECRET="dev-secret-change-in-production-min-32-chars-please"
JWT_ACCESS_EXPIRY="15m"
JWT_REFRESH_EXPIRY="7d"

# ============================================================================
# Email (SMTP) - Optional
# ============================================================================
SMTP_HOST="smtp.mailtrap.io"
SMTP_PORT="2525"
SMTP_USER="your-mailtrap-user"
SMTP_PASS="your-mailtrap-password"

# ============================================================================
# Object Storage (S3-compatible) - Optional
# ============================================================================
S3_ENDPOINT="http://localhost:9000"
S3_BUCKET="iam-uploads"
S3_ACCESS_KEY="minioadmin"
S3_SECRET_KEY="minioadmin"

# ============================================================================
# API Configuration
# ============================================================================
API_PORT="3000"
API_CORS_ORIGIN="http://localhost:3001"

# ============================================================================
# Feature Flags - Optional
# ============================================================================
ENABLE_API_DOCS="true"
ENABLE_GRAPHQL_PLAYGROUND="true"
